# ============================================================================
# Ghiền Phim — biến môi trường MẪU
#
# Copy file này thành `.env.local` rồi điền giá trị thật:
#   Windows (PowerShell):  copy .env.example .env.local
#   macOS / Linux:        cp .env.example .env.local
#
# ⚠️ KHÔNG BAO GIỜ điền key thật vào file này — nó được commit vào git.
#    `.env.local` mới là file chứa bí mật (đã nằm trong .gitignore).
# ============================================================================

# --- Supabase (bắt buộc để chạy production) -------------------------------
# Project URL — lấy ở Supabase Dashboard → Project Settings → API → Project URL
# KHÔNG kèm "/rest/v1/" ở cuối.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable / anon key — key công khai, an toàn để đưa vào client bundle.
# Lấy ở Project Settings → API → Publishable key (hoặc anon public key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<your-publishable-key>

# Secret / service_role key — CHỈ dùng ở server, KHÔNG có tiền tố NEXT_PUBLIC.
# Dùng cho: npm run db:bootstrap-admin, upload Storage, thao tác SQL trực tiếp.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<your-secret-key>

# --- Database (tuỳ chọn) ---------------------------------------------------
# Pooler connection — chỉ cần khi chạy script migration bằng `psql`.
# Lấy ở Project Settings → Database → Connection string (Session pooler).
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_USER=postgres.<project-ref>
DB_NAME=postgres
DB_PASSWORD=<your-db-password>
DB_SSL=true

# --- Site ------------------------------------------------------------------
# URL gốc của website. Dùng cho sitemap, robots, canonical và Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3111

# --- Một Chút (`motchutphim.com`) API Cộng Tác Viên (tuỳ chọn) -------------
# Mã CTV 32 ký tự do Admin Một Chút cấp để đẩy phim/tập từ trang quản trị.
# Chỉ dùng ở server (không đặt tiền tố NEXT_PUBLIC_).
MOTCHUT_CTV_CODE=LfB0c5uQY8KO9mRlBigM03Ov07Rxvs_v
